# URL do webhook de produção do n8n. Esta variável é lida somente no servidor/proxy TanStack.
JAGUAR_N8N_WEBHOOK_BASE_URL=https://n8n.facilities-ai.com.br/webhook

# Mobile Jaguar / distribuição APK e fotos de estoque
JAGUAR_UPLOAD_DIR=/data/jaguar/uploads
JAGUAR_ANDROID_APK_PATH=/data/jaguar/releases/jaguar-radiadores.apk
JAGUAR_ANDROID_APP_VERSION=1.0.0
# Alternativa rápida ao arquivo local: URL HTTPS direta do APK assinado
# JAGUAR_ANDROID_APK_URL=https://.../Jaguar-Radiadores-v1.0.0.apk
